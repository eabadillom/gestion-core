<?xml version="1.0" encoding="UTF-8"?>
<persistence version="2.1" 
        xmlns="http://xmlns.jcp.org/xml/ns/persistence" 
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
        xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/persistence http://xmlns.jcp.org/xml/ns/persistence/persistence_2_1.xsd">
        <persistence-unit name="gestionCore" transaction-type="RESOURCE_LOCAL">
            <exclude-unlisted-classes>false</exclude-unlisted-classes>
            <properties>
                <!-- Datos de la conexión JDBC -->
                <!--<property name="hibernate.connection.driver_class" value="com.mysql.cj.jdbc.Driver"/>
                <property name="hibernate.connection.url" value="jdbc:mysql://127.0.0.1:3306/gestiondb"/>
                <property name="hibernate.connection.username" value="gestion"/>
                <property name="hibernate.connection.password" value="pruebas123"/>--> 
                
                <!-- Dialecto de Hibernate -->
                <property name="hibernate.dialect" value="org.hibernate.dialect.MySQL8Dialect" />
                <property name="hibernate.connection.datasource" value="java:comp/env/jdbc/gestion"/>
                <property name="hibernate.show_sql" value="false" />
            </properties>
        </persistence-unit>
</persistence>

